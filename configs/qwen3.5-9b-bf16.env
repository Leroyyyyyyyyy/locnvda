# Qwen3.5-9B BF16，单卡。用途：阶段 3 量化对比的基准（效果和速度都以它为准）。
# 权重 19.3GB（含视觉编码器和 MTP 层，language-model-only 实际加载约 17 GiB）。
# 预计 KV cache 只剩约 2 GiB → 约 5 万 token，chat 高并发时会因显存不够而排队。
#
# 9B 三份配置（bf16 / awq / fp8）除 MODEL_ID 外参数完全相同，量化方式是唯一变量。
# 必须在同一台实例上依次跑完（同一型号 GPU），三个模型共约 43GB，租 80GB 磁盘。

MODEL_ID="Qwen/Qwen3.5-9B"
SERVED_MODEL_NAME="qwen3.5-9b"
QUANTIZATION=""
DTYPE="auto"

TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192          # 刚好能跑标准套件的 long workload（7680+256），再大会进一步压缩 BF16 的并发
KV_CACHE_DTYPE="auto"
MAX_NUM_SEQS=64

LANGUAGE_MODEL_ONLY=1
REASONING_PARSER="qwen3"
ENFORCE_EAGER=0

HOST=127.0.0.1
PORT=8000
EXTRA_ARGS=""

MIN_GPU_COUNT=1
MIN_GPU_MEM_GB=24
MIN_DISK_GB=80
