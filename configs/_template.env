# 部署方案配置模板：复制为 configs/<方案名>.env 后修改。
# 脚本只读这里的变量，换模型/方案不改代码。
# 密钥（HF_TOKEN、API_KEY）不要写在这里，放仓库根目录的 .env（已被 .gitignore 忽略）。

# --- 模型 ---
MODEL_ID=""                 # HF 仓库名，见 HANDOFF.md 第 8.1 节
SERVED_MODEL_NAME=""        # OpenAI 接口里的 model 字段，空则用 MODEL_ID
QUANTIZATION=""             # 空 = 让 vLLM 从模型 config.json 自动识别（BF16/AWQ/FP8 仓库都会自带量化信息）
DTYPE="auto"                # 非量化部分的计算精度，auto = 用模型自带的（Qwen3.5 是 bfloat16）

# --- 并行 / 显存 ---
TENSOR_PARALLEL_SIZE=1      # 张量并行卡数：每层权重切成 N 份分到 N 张卡
GPU_MEMORY_UTILIZATION=0.90 # vLLM 最多用每张卡显存的这个比例；减去权重和激活，剩下全部给 KV cache
MAX_MODEL_LEN=8192          # 单个请求的最大上下文（输入 + 输出 token），必须至少能放下一个完整请求的 KV cache
KV_CACHE_DTYPE="auto"       # auto = 跟模型精度一致；fp8 = KV cache 减半，同样显存能放更多 token
MAX_NUM_SEQS=64             # 调度器同时处理的最大请求数（并发上限）

# --- Qwen3.5 相关 ---
LANGUAGE_MODEL_ONLY=1       # 1 = 不加载视觉编码器，只做文本服务，省显存
REASONING_PARSER="qwen3"    # 把 <think> 思考内容拆到响应的 reasoning_content 字段
ENFORCE_EAGER=0             # 1 = 关闭 CUDA graph：省显存、启动快，但推理变慢

# --- 服务 ---
HOST=127.0.0.1              # 只监听本机，通过 SSH 隧道访问；改 0.0.0.0 会把无鉴权接口暴露到公网
PORT=8000
EXTRA_ARGS=""               # 其他 vllm serve 参数原样追加

# --- 实例要求（仅作记录，供选机参考） ---
MIN_GPU_COUNT=1
MIN_GPU_MEM_GB=24
MIN_DISK_GB=80
