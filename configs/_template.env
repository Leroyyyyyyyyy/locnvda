# 部署方案配置模板：复制为 configs/<方案名>.env 后修改。
# 脚本只读这里的变量，换模型/方案不改代码。

# --- 模型 ---
MODEL_ID=""                 # HF 仓库名，部署前在 HF 上确认，例如 Qwen/<待确认>
SERVED_MODEL_NAME=""        # OpenAI 接口里的 model 字段
QUANTIZATION=""             # 空=原精度(BF16) | awq | fp8
DTYPE="auto"

# --- 并行 / 显存 ---
TENSOR_PARALLEL_SIZE=1      # 卡数
GPU_MEMORY_UTILIZATION=0.90 # vLLM 可用显存比例，剩余给 KV cache 之外的开销
MAX_MODEL_LEN=8192          # 单请求最大上下文（输入+输出）
KV_CACHE_DTYPE="auto"       # auto | fp8
MAX_NUM_SEQS=64             # 最大并发序列数

# --- 服务 ---
HOST=0.0.0.0
PORT=8000

# --- 实例要求（仅作记录，供选机参考） ---
MIN_GPU_COUNT=1
MIN_GPU_MEM_GB=24
MIN_DISK_GB=80
