# Qwen3.5-9B FP8（RedHatAI 社区版），单卡。用途：阶段 3 量化对比。
# 权重 14.0GB。预计 KV cache 约 7 GiB。
#
# 格式是 compressed-tensors：权重 FP8 按通道静态 scale，激活 FP8 按 token 动态 scale（W8A8）。
# 只量化了 full attention 和 MLP 的 Linear，线性注意力层的投影、lm_head、MTP 都保留 BF16，所以比 AWQ 大不少。
# QUANTIZATION 留空，vLLM 从 config.json 自动识别。
# GPU 型号决定走哪条路径：
#   - 4090（Ada，有 FP8 Tensor Core）：真正的 W8A8 FP8 矩阵乘
#   - 3090（Ampere，无 FP8 单元）：退化为 Marlin 只读 FP8 权重、按 BF16 计算（W8A16），只省带宽
# 记录结果时注意是哪种 GPU，两者的速度结论不能混用。
#
# 9B 三份配置（bf16 / awq / fp8）除 MODEL_ID 外参数完全相同，见 qwen3.5-9b-bf16.env。

MODEL_ID="RedHatAI/Qwen3.5-9B-FP8-dynamic"
SERVED_MODEL_NAME="qwen3.5-9b-fp8"
QUANTIZATION=""
DTYPE="auto"

TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
KV_CACHE_DTYPE="auto"
MAX_NUM_SEQS=64

LANGUAGE_MODEL_ONLY=1
REASONING_PARSER="qwen3"
ENFORCE_EAGER=0

HOST=127.0.0.1
PORT=8000
EXTRA_ARGS=""

MIN_GPU_COUNT=1
MIN_GPU_MEM_GB=24
MIN_DISK_GB=80
