# Qwen3.5-27B 官方 FP8，方案 b：同机 2×24GB，TP=2。
# 权重约 30.9GB；先在 2×4090 上跑通，再与相同参数的 AWQ 配置对比。
# HF config.json：quant_method=fp8，权重 block_size=[128,128]，激活动态量化。
# QUANTIZATION 留空自动识别；实际采用的 FP8 kernel 以 vLLM 启动日志为准。
# TP 切分每层权重，不是两个独立副本；每层需要跨卡通信。
# 两份配置除仓库和 API 模型名外保持一致；KV cache 保持 BF16，不混入缓存量化。

MODEL_ID="Qwen/Qwen3.5-27B-FP8"
SERVED_MODEL_NAME="qwen3.5-27b-fp8"
QUANTIZATION=""
DTYPE="auto"

TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
KV_CACHE_DTYPE="auto"
MAX_NUM_SEQS=64

LANGUAGE_MODEL_ONLY=1
REASONING_PARSER="qwen3"
ENFORCE_EAGER=0

HOST=127.0.0.1
PORT=8000
EXTRA_ARGS=""

MIN_GPU_COUNT=2
MIN_GPU_MEM_GB=24
MIN_DISK_GB=150
