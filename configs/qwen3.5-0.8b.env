# Qwen3.5-0.8B BF16，单卡。用途：跑通部署流程。
# 权重 1.7GB，24GB 卡上绝大部分显存会分给 KV cache。

MODEL_ID="Qwen/Qwen3.5-0.8B"
SERVED_MODEL_NAME="qwen3.5-0.8b"
QUANTIZATION=""
DTYPE="auto"

TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
KV_CACHE_DTYPE="auto"
MAX_NUM_SEQS=64

LANGUAGE_MODEL_ONLY=1
REASONING_PARSER="qwen3"
ENFORCE_EAGER=0

HOST=127.0.0.1
PORT=8000
EXTRA_ARGS=""

MIN_GPU_COUNT=1
MIN_GPU_MEM_GB=24
MIN_DISK_GB=50
