# Qwen3.5-27B 社区 AWQ 4bit，方案 b：同机 2×24GB，TP=2。
# 权重约 20.1GB；与相同部署参数的官方 FP8 版本对比。
# HF config.json：compressed-tensors，W4A16，对称 int4，group_size=32。
# QUANTIZATION 留空自动识别，不要指定 awq（与仓库量化格式不匹配）。
# TP 切分每层权重，不是两个独立副本；每层需要跨卡通信。
# 两份配置除仓库和 API 模型名外保持一致；KV cache 保持 BF16，不混入缓存量化。

MODEL_ID="cyankiwi/Qwen3.5-27B-AWQ-4bit"
SERVED_MODEL_NAME="qwen3.5-27b-awq"
QUANTIZATION=""
DTYPE="auto"

TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
KV_CACHE_DTYPE="auto"
MAX_NUM_SEQS=64

LANGUAGE_MODEL_ONLY=1
REASONING_PARSER="qwen3"
ENFORCE_EAGER=0

HOST=127.0.0.1
PORT=8000
EXTRA_ARGS=""

MIN_GPU_COUNT=2
MIN_GPU_MEM_GB=24
MIN_DISK_GB=150
