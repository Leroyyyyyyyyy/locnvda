# Qwen3.5-9B 4bit 权重量化（社区版），单卡。用途：阶段 3 量化对比。
# 权重 9.1GB。预计 KV cache 约 12 GiB，是 BF16 的 5 倍以上。
#
# 仓库叫 AWQ，但格式是 compressed-tensors（llm-compressor 导出）：W4A16，group_size=32，对称 int4。
# 除 lm_head 和线性注意力的 in_proj_a/b 外，所有 Linear 都量化了。
# 所以 QUANTIZATION 必须留空让 vLLM 从 config.json 识别；写成 awq 会和 config.json 里的方法不一致，启动直接报错。
# 推理时用 Marlin kernel：权重以 int4 读进来、在 kernel 里反量化成 BF16 再算，省的是显存带宽，不是算力。
#
# 9B 三份配置（bf16 / awq / fp8）除 MODEL_ID 外参数完全相同，见 qwen3.5-9b-bf16.env。

MODEL_ID="cyankiwi/Qwen3.5-9B-AWQ-4bit"
SERVED_MODEL_NAME="qwen3.5-9b-awq"
QUANTIZATION=""
DTYPE="auto"

TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
KV_CACHE_DTYPE="auto"
MAX_NUM_SEQS=64

LANGUAGE_MODEL_ONLY=1
REASONING_PARSER="qwen3"
ENFORCE_EAGER=0

HOST=127.0.0.1
PORT=8000
EXTRA_ARGS=""

MIN_GPU_COUNT=1
MIN_GPU_MEM_GB=24
MIN_DISK_GB=80
